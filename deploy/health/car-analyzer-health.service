[Unit]
Description=Read-only Car Analyzer operational health status
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/car-analyzer
ExecStart=/usr/bin/python3 /opt/car-analyzer/scripts/collector_health.py
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/car-analyzer/.collector-health
MemoryMax=256M
CPUQuota=40%
